# Copy to .env (ignored by Git). Every setting is optional: with nothing set,
# SentinelLoop uses the built-in sandbox assistant and needs no API key.

# --- Defenses -------------------------------------------------------------
# Profile used by /v1/chat/completions: none | keyword | detectors | full
SENTINELLOOP_DEFENSE_PROFILE=full
# Similarity-search threshold. Leave unset to use the value tuned on the validation
# split and stored with the model.
# SENTINELLOOP_SIMILARITY_THRESHOLD=0.65

# --- Storage --------------------------------------------------------------
# Defaults to sqlite in artifacts/sentinelloop.db. Docker Compose uses PostgreSQL.
# SENTINELLOOP_DATABASE_URL=sqlite:///artifacts/sentinelloop.db

# --- Optional hosted model (any OpenAI-compatible API) ----------------------
# Example: Groq. Leave SENTINELLOOP_UPSTREAM_URL empty to stay on the sandbox.
SENTINELLOOP_UPSTREAM_URL=
# SENTINELLOOP_UPSTREAM_URL=https://api.groq.com/openai/v1
SENTINELLOOP_MODEL=openai/gpt-oss-20b
SENTINELLOOP_API_KEY=
# "sandbox" gives the hosted model MailPilot's system prompt (fake secret + canary)
# so you can attack a real model and still measure leaks with the output guard.
SENTINELLOOP_UPSTREAM_PERSONA=

# Optional overrides for the LLM-assisted fuzzer and judge
# SENTINELLOOP_ATTACKER_MODEL=
# SENTINELLOOP_JUDGE_MODEL=
